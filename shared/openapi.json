{
  "openapi": "3.1.0",
  "info": {
    "title": "8004rep",
    "version": "0.1.0"
  },
  "paths": {
    "/api/agents": {
      "get": {
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Agents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "number"
                      },
                      "network": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "owner": {
                        "type": "string"
                      },
                      "feedbackCount": {
                        "type": "number"
                      },
                      "score": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "active",
                          "quiet",
                          "unreviewed"
                        ]
                      },
                      "registeredAt": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      }
                    },
                    "required": [
                      "id",
                      "network",
                      "name",
                      "owner",
                      "feedbackCount",
                      "score",
                      "status",
                      "registeredAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/networks": {
      "get": {
        "operationId": "listNetworks",
        "responses": {
          "200": {
            "description": "Networks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "color": {
                        "type": "string",
                        "enum": [
                          "gray",
                          "orange",
                          "iris",
                          "blue",
                          "teal"
                        ]
                      },
                      "chainId": {
                        "type": "number"
                      },
                      "testnet": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "name",
                      "symbol",
                      "color",
                      "chainId",
                      "testnet"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
