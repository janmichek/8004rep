{
  "openapi": "3.1.0",
  "info": {
    "title": "8004rep",
    "version": "0.1.0"
  },
  "paths": {
    "/api/agents": {
      "get": {
        "operationId": "listAgents",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "env",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mainnet",
                "testnet"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "registered",
                "score",
                "feedback"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "chainId": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "tokenId": {
                            "type": "string",
                            "pattern": "^\\d+$"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "imageUrl": {
                            "type": "string"
                          },
                          "owner": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "protocols": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "x402": {
                            "type": "boolean"
                          },
                          "totalScore": {
                            "type": "number"
                          },
                          "averageScore": {
                            "type": "number"
                          },
                          "feedbackCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "createdAt": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "testnet": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "chainId",
                          "tokenId",
                          "owner",
                          "protocols",
                          "x402",
                          "totalScore",
                          "averageScore",
                          "feedbackCount",
                          "testnet"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "hasMore": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "items",
                    "total",
                    "hasMore"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/networks": {
      "get": {
        "operationId": "listNetworks",
        "responses": {
          "200": {
            "description": "Networks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "color": {
                        "type": "string",
                        "enum": [
                          "gray",
                          "orange",
                          "iris",
                          "blue",
                          "teal"
                        ]
                      },
                      "chainId": {
                        "type": "number"
                      },
                      "testnet": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "name",
                      "symbol",
                      "color",
                      "chainId",
                      "testnet"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
