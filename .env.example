# Copy to `.env.local` for local app overrides.
# The deployment variables below are read by GitHub Actions, not by the app at runtime.

# --- Deployment (GitHub Actions secrets) ---
# Create a token: https://vercel.com/account/tokens
VERCEL_TOKEN=
# Both IDs are in `.vercel/project.json` after `vercel link`
# or in the Vercel project settings: Project Settings -> General.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Local app overrides (optional) ---
# Replace a network's public RPC: VITE_RPC_URL_<chainId>
# Set or replace a network's subgraph: VITE_SUBGRAPH_URL_<chainId>
# Chain IDs are listed in README.md and src/chains.ts.
VITE_RPC_URL_421614=
VITE_SUBGRAPH_URL_84532=
