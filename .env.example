# CHROMATIC_PROJECT_TOKEN=https://www.chromatic.com/docs/faq/find-project-token/
# VITE_SENTRY_DSN=https://docs.sentry.io/concepts/key-terms/dsn-explainer/#where-to-find-your-data-source-name-dsn
# PostgreSQL used by the API and the indexer; `bun run dev` starts one via compose.yaml.
DATABASE_URL=postgres://rep:rep@localhost:5432/rep
# Optional comma-separated chain ids; defaults to every chain in shared/chains.ts.
INDEXER_CHAINS=
# How often the indexer polls every chain head, in milliseconds.
INDEXER_POLL_MS=15000
# Per-chain log RPC overrides, e.g. INDEXER_RPC_URL_8453=https://...
INDEXER_RPC_URL_8453=
