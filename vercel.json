{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "bun run build",
  "outputDirectory": "build",
  "installCommand": "bun install --frozen-lockfile",
  "functions": {
    "api/fetch-json.ts": {
      "maxDuration": 10
    },
    "api/index.ts": {
      "maxDuration": 10
    },
    "api/probe.ts": {
      "maxDuration": 10
    }
  }
}
