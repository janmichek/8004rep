{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": ["src/**/model/**/*.ts", "src/**/lib/**/*.ts", "!src/**/*.test.ts"],
  "ignorePatterns": [".agents", ".claude", ".cursor", ".github", "docs", "examples", "/agent"],
  "concurrency": 4,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 80
  },
  "reporters": ["clear-text"],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp"
}
