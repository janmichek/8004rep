{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "shared/reputation/**/*.ts",
    "!shared/reputation/**/*.test.ts",
    "server/indexer/**/*.ts",
    "!server/indexer/run.ts",
    "!server/indexer/**/*.test.ts",
    "server/db/**/*.ts",
    "!server/db/**/*.test.ts",
    "!server/db/migrate.ts"
  ],
  "ignorePatterns": [".agents", ".claude", ".cursor", ".github", "docs", "examples", "/agent"],
  "concurrency": 4,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 75,
    "low": 60,
    "break": 66
  },
  "reporters": ["clear-text"],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp"
}
