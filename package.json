{
  "name": "8004rep",
  "version": "0.1.0",
  "description": "Simple read-only ERC-8004 agent explorer, inspired by 8004scan.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/src/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@lucide/vue": "^1.61.0",
    "hono": "^4.13.20",
    "reka-ui": "^2.11.0",
    "tsx": "^4.23.15",
    "viem": "^2.57.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
